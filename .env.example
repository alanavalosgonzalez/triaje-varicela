# Plantilla de configuración: copia este archivo como .env y rellena los valores.
# El archivo .env real está en .gitignore para no publicar tus claves.

# Ruta del archivo de base de datos SQLite.
DB_PATH=data/triaje_varicela.db

# Clave de la API de Google Gemini (se obtiene en https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Modelo de Gemini a usar; cámbialo aquí si Google publica uno nuevo o retira este.
GEMINI_MODELO=gemini-3.8-flash

# Umbral mínimo de confianza del análisis de imagen. Déjalo comentado para usar el recomendado,
# que viene en models/varicela.json y se calculó con la validación cruzada.
# VISION_UMBRAL_CONFIANZA=0.70
